# Horizon — docker-compose configuration.
# Copy to `.env` next to docker-compose.yml and edit. `.env` is gitignored.
#
#   cp .env.example .env && nano .env && docker compose up -d

# ─── Required: host paths (bind mounts) ──────────────────────────────────────
# Your media tree (mounted read-only at /media) and a writable config dir
# (mounted at /config — holds the SQLite DB = settings/users/library/auth, plus
# the transcode cache). Plex-style. On TrueNAS these are dataset paths under
# /mnt/<pool>/...
#
# Mount the PARENT directory that contains your movies/shows folders — you then
# pick the actual library folders at runtime in the web UI (first-run setup or
# Settings) with a filesystem browser. There is no base env var: the browser can
# reach anything the container can read, which is exactly the volume(s) you mount,
# so the mount itself is the boundary. Add more `…:ro` mounts to expose more trees.
HORIZON_MEDIA_HOST=/mnt/tank/media
HORIZON_DATA_HOST=/mnt/tank/apps/horizon/config

# ─── User mapping ────────────────────────────────────────────────────────────
# The container runs as this uid:gid and must OWN HORIZON_DATA_HOST (chown it).
# TrueNAS SCD's "apps" user is 568:568. Read-only media mounts don't need it.
PUID=568
PGID=568
TZ=Europe/Amsterdam

# ─── Networking ──────────────────────────────────────────────────────────────
HORIZON_PORT=7777
# Horizon has built-in username+password auth with revocable sessions, so it's
# safe to port-forward (like Plex/Jellyfin). Still put it behind TLS — a reverse
# proxy or Cloudflare Tunnel — so the session cookie gets the Secure flag (set
# when the proxy forwards X-Forwarded-Proto=https) and traffic is encrypted.
#
# The web UI is bundled and served by the server itself (open http://<nas>:7777),
# so it's same-origin and CORS can stay OFF (empty = the secure default). Only
# set this if you host the web client on a SEPARATE origin (then list it, e.g.
# https://horizon.example.com). "*" is flagged at startup in production.
HORIZON_CORS_ORIGINS=
# Set to 0 to run the server headless (no bundled web UI).
HORIZON_SERVE_WEB=1
# Friendly name advertised to TV clients (defaults to OS hostname)
HORIZON_SERVER_NAME=
# Advertise the server over mDNS (_horizon._tcp). Default on. Note: bridged
# Docker networks block multicast — TV clients then find the server via subnet
# scan or manual entry. Use network_mode: host for in-container mDNS.
HORIZON_MDNS=1

# ─── Owner lockout escape hatch ──────────────────────────────────────────────
# Forgot the owner password, or locked out by too many failed logins?
# Set to 1 and boot ONCE: the server clears the owner's password + lockout on
# startup, then forces the owner through set-password again (like first boot).
# WARNING: leaving this at 1 wipes the owner's password on EVERY boot — set it
# back to 0 (or remove the line) and restart after you've reset the password.
# HORIZON_RESET_OWNER_PASSWORD=0

# ─── Metadata (optional) ─────────────────────────────────────────────────────
# TMDB API Read Access Token for poster/backdrop/synopsis enrichment.
# Without it the server runs fine; only metadata is skipped.
HORIZON_TMDB_TOKEN=

# ─── Transcoding (optional) ──────────────────────────────────────────────────
# Concurrent playback sessions / renditions per session.
HORIZON_MAX_SESSIONS=4
HORIZON_MAX_RENDITIONS=3
# Hardware encoder. Leave EMPTY for safe auto-detect (probes the host and falls
# back to CPU/libx264 if no working GPU is present). To force, set one of:
#   h264_qsv / hevc_qsv      (Intel iGPU — also uncomment /dev/dri in compose)
#   h264_nvenc / hevc_nvenc  (NVIDIA — also enable the nvidia device in compose)
HORIZON_FORCE_ENCODER=
HORIZON_TONEMAP_OPERATOR=hable
HORIZON_SCAN_CONCURRENCY=4
HORIZON_WATCHED_THRESHOLD_PCT=90

# ─── Library scanning ────────────────────────────────────────────────────────
HORIZON_SCAN_CRON_HOUR=3
# Filesystem watcher: reliable only on LOCAL filesystems (ZFS datasets).
# Set to 0 if your media is an SMB/NFS mount (inotify won't fire there).
HORIZON_WATCH_FS=1
HORIZON_WATCH_DEBOUNCE_MS=5000

# ─── Metadata refresh cadence (days) ─────────────────────────────────────────
HORIZON_METADATA_BATCH_SIZE=50
HORIZON_METADATA_MAX_AGE_MOVIE_DAYS=30
HORIZON_METADATA_MAX_AGE_SHOW_DAYS=7
HORIZON_METADATA_MAX_AGE_EPISODE_DAYS=60
