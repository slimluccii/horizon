{
  "name": "@horizon/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --watch --loader ts-node/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "seed:mock": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --loader ts-node/esm scripts/seed-mock.ts"
  },
  "dependencies": {
    "@horizon/sdk": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^8.3.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^4.28.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
